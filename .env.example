# Copie este arquivo para ".env" e ajuste os valores. O arquivo ".env" nunca vai para o GitHub.
DEBUG=True
SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1

# Sem DATABASE_URL, o projeto usa SQLite local (bom para desenvolver e testar).
# Em produção (Neon/PostgreSQL), defina a URL de conexão:
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
